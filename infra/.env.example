# ============================================================
# Variáveis de ambiente — Dr. João Holanda Infrastructure
# Copie para .env e preencha ANTES de rodar docker compose up
# ============================================================

# IP público da VPS (sem http://)
VPS_IP=

# ── PostgreSQL ───────────────────────────────────────────────
POSTGRES_USER=automacao
POSTGRES_PASSWORD=TROQUE_POR_SENHA_FORTE_32_CHARS
POSTGRES_DB=automacao

# Bancos individuais (criados via init-db.sql)
N8N_DB_NAME=n8n
EVOLUTION_DB_NAME=evolution

# ── Redis ────────────────────────────────────────────────────
REDIS_PASSWORD=TROQUE_POR_SENHA_FORTE_32_CHARS

# ── n8n ──────────────────────────────────────────────────────
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=TROQUE_POR_SENHA_FORTE
N8N_ENCRYPTION_KEY=GERE_COM_openssl_rand_hex_32

# ── Evolution API ────────────────────────────────────────────
EVOLUTION_API_KEY=GERE_COM_openssl_rand_hex_32

# ── Telegram — canal definitivo ─────────────────────────────
# Token do @BotFather (comando /newbot).
TELEGRAM_BOT_TOKEN=

# Quem o agente reconhece e com quem conversa. Formato por pessoa:
# "chat_id:Nome:papel:tratamento", separado por vírgula.
# papel = paciente | filho | filha | familiar (ajusta o tom da resposta)
# Exemplo:
# TELEGRAM_CONTATOS="123:Edilson Cavalcante:paciente:Sr. Edilson, 456:Erick Cavalcante:filho:Erick, 789:Edilson Junior:filho:Junior, 321:Camila Cavalcante:filha:Camila"
TELEGRAM_CONTATOS=

# Todo chat_id de TELEGRAM_CONTATOS deve constar aqui também — sem isso o
# agente não responde à pessoa (assistente privado, não chatbot aberto).
# TELEGRAM_ALLOWED_IDS="123,456,789,321"
TELEGRAM_ALLOWED_IDS=

# Quem recebe alerta clínico (PSA/eTFG fora da faixa). Aceita o chat_id do
# grupo da família (número negativo) OU os IDs dos filhos individualmente —
# nunca o do paciente, para não alarmá-lo diretamente.
TELEGRAM_FAMILIA_IDS=

# Quem pode dar orientação permanente de comportamento ao agente (/orientar).
# Separado de FAMILIA_IDS: alertar não é o mesmo que administrar.
TELEGRAM_ADMIN_IDS=

# Token exigido nos endpoints sensíveis (/telegram/contatos, /memoria/*,
# /voz/*, etc). Gere com: openssl rand -hex 32
AGENT_ACCESS_TOKEN=

# Hora (horário de Brasília, sem minuto) do resumo diário da família.
# CLAUDE.md §5 pede 20h — só mude se precisar testar outro horário.
HORA_RELATORIO_FAMILIA=20
